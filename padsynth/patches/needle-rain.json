{"description": "Bright plucky pad with forward delay. Fast attack, open filter.", "id": "needle-rain", "name": "Needle Rain", "nodes": [{"id": "osc1", "params": {"detune_cents": 8.0, "gain": 0.5, "octave": 0, "pulse_mix": 0.1, "saw_mix": 0.8, "sub_sine": 0.2}, "type": "osc_stack"}, {"id": "ens1", "params": {"chorus_depth_ms": 2.5, "chorus_rate_hz": 0.3, "gain": 0.35, "spread_cents": 10.0, "voices": 2}, "type": "string_ensemble"}, {"id": "air1", "params": {"cutoff_hz": 9000.0, "gain": 0.2}, "type": "noise_air"}, {"id": "lfo1", "params": {"rate_hz": 0.25, "shape": "sine"}, "type": "lfo"}, {"id": "lfo2", "params": {"rate_hz": 0.4, "shape": "tri"}, "type": "lfo"}, {"id": "route1", "inputs": {"lfo": "lfo1"}, "params": {"amount": 0.3, "dst": "cutoff", "src": "lfo1"}, "type": "mod_route"}, {"id": "route2", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.2, "dst": "detune", "src": "lfo2"}, "type": "mod_route"}, {"id": "route3", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.4, "dst": "pan", "src": "lfo2"}, "type": "mod_route"}, {"id": "filt1", "inputs": {}, "params": {"cutoff_hz": 5200.0, "env_amount": 0.7, "key_track": 0.5, "resonance": 0.35}, "type": "filter_lp"}, {"id": "env1", "params": {"attack_s": 0.05, "decay_s": 0.4, "release_s": 1.2, "sustain": 0.5}, "type": "amp_env"}, {"id": "mix1", "inputs": {"a": "osc1", "b": "ens1", "c": "air1"}, "params": {"gain": 1.0}, "type": "mixer"}, {"id": "ch1", "inputs": {"in": "mix1"}, "params": {"depth_ms": 4.0, "mix": 0.3, "rate": 0.5}, "type": "chorus"}, {"id": "dly1", "inputs": {"in": "ch1"}, "params": {"damp": 0.3, "feedback": 0.45, "mix": 0.3, "time_ms": 280.0}, "type": "delay"}, {"id": "vrb1", "inputs": {"in": "dly1"}, "params": {"damp": 0.4, "mix": 0.3, "size": 0.5}, "type": "reverb"}, {"id": "out", "inputs": {"in": "vrb1"}, "params": {"gain": 0.75, "softclip": true, "width": 1.1}, "type": "output"}], "schema": "padsynth-patch/1.0"}