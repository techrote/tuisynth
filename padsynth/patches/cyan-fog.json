{"description": "Smooth cold haze with sparse signal grain. Dark filter, huge space.", "id": "cyan-fog", "name": "Cyan Fog", "nodes": [{"id": "osc1", "params": {"detune_cents": 10.0, "gain": 0.45, "octave": -1, "pulse_mix": 0.0, "saw_mix": 0.5, "sub_sine": 0.6}, "type": "osc_stack"}, {"id": "ens1", "params": {"chorus_depth_ms": 3.0, "chorus_rate_hz": 0.1, "gain": 0.4, "spread_cents": 12.0, "voices": 3}, "type": "string_ensemble"}, {"id": "air1", "params": {"cutoff_hz": 4000.0, "gain": 0.18}, "type": "noise_air"}, {"id": "lfo1", "params": {"rate_hz": 0.05, "shape": "sine"}, "type": "lfo"}, {"id": "lfo2", "params": {"rate_hz": 0.07, "shape": "sine"}, "type": "lfo"}, {"id": "route1", "inputs": {"lfo": "lfo1"}, "params": {"amount": 0.35, "dst": "cutoff", "src": "lfo1"}, "type": "mod_route"}, {"id": "route2", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.25, "dst": "detune", "src": "lfo2"}, "type": "mod_route"}, {"id": "route3", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.6, "dst": "pan", "src": "lfo2"}, "type": "mod_route"}, {"id": "filt1", "inputs": {}, "params": {"cutoff_hz": 900.0, "env_amount": 0.3, "key_track": 0.2, "resonance": 0.15}, "type": "filter_lp"}, {"id": "env1", "params": {"attack_s": 2.5, "decay_s": 3.0, "release_s": 5.0, "sustain": 0.85}, "type": "amp_env"}, {"id": "mix1", "inputs": {"a": "osc1", "b": "ens1", "c": "air1"}, "params": {"gain": 1.0}, "type": "mixer"}, {"id": "ch1", "inputs": {"in": "mix1"}, "params": {"depth_ms": 2.5, "mix": 0.2, "rate": 0.3}, "type": "chorus"}, {"id": "dly1", "inputs": {"in": "ch1"}, "params": {"damp": 0.6, "feedback": 0.3, "mix": 0.18, "time_ms": 500.0}, "type": "delay"}, {"id": "vrb1", "inputs": {"in": "dly1"}, "params": {"damp": 0.7, "mix": 0.55, "size": 0.9}, "type": "reverb"}, {"id": "out", "inputs": {"in": "vrb1"}, "params": {"gain": 0.85, "softclip": true, "width": 1.2}, "type": "output"}], "schema": "padsynth-patch/1.0"}