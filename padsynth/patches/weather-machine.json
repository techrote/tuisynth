{"description": "Compound pad: supersaw + string ensemble + air through a slow filter.", "id": "weather-machine", "name": "Weather Machine", "nodes": [{"id": "osc1", "params": {"detune_cents": 12.0, "gain": 0.5, "octave": 0, "pulse_mix": 0.2, "saw_mix": 0.7, "sub_sine": 0.4}, "type": "osc_stack"}, {"id": "ens1", "params": {"chorus_depth_ms": 4.0, "chorus_rate_hz": 0.15, "gain": 0.4, "spread_cents": 18.0, "voices": 3}, "type": "string_ensemble"}, {"id": "air1", "params": {"cutoff_hz": 6500.0, "gain": 0.12}, "type": "noise_air"}, {"id": "lfo1", "params": {"rate_hz": 0.08, "shape": "sine"}, "type": "lfo"}, {"id": "lfo2", "params": {"rate_hz": 0.13, "shape": "tri"}, "type": "lfo"}, {"id": "route1", "inputs": {"lfo": "lfo1"}, "params": {"amount": 0.45, "dst": "cutoff", "src": "lfo1"}, "type": "mod_route"}, {"id": "route2", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.3, "dst": "detune", "src": "lfo2"}, "type": "mod_route"}, {"id": "route3", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.5, "dst": "pan", "src": "lfo2"}, "type": "mod_route"}, {"id": "filt1", "inputs": {}, "params": {"cutoff_hz": 2200.0, "env_amount": 0.5, "key_track": 0.4, "resonance": 0.25}, "type": "filter_lp"}, {"id": "env1", "params": {"attack_s": 1.2, "decay_s": 2.0, "release_s": 3.0, "sustain": 0.75}, "type": "amp_env"}, {"id": "mix1", "inputs": {"a": "osc1", "b": "ens1", "c": "air1"}, "params": {"gain": 1.0}, "type": "mixer"}, {"id": "ch1", "inputs": {"in": "mix1"}, "params": {"depth_ms": 3.0, "mix": 0.25, "rate": 0.4}, "type": "chorus"}, {"id": "dly1", "inputs": {"in": "ch1"}, "params": {"damp": 0.4, "feedback": 0.35, "mix": 0.22, "time_ms": 375.0}, "type": "delay"}, {"id": "vrb1", "inputs": {"in": "dly1"}, "params": {"damp": 0.5, "mix": 0.4, "size": 0.75}, "type": "reverb"}, {"id": "out", "inputs": {"in": "vrb1"}, "params": {"gain": 0.8, "softclip": true, "width": 1.0}, "type": "output"}], "schema": "padsynth-patch/1.0"}