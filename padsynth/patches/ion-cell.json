{"description": "Tight cellular pressure pocket. Narrow filter, wide ensemble.", "id": "ion-cell", "name": "Ion Cell", "nodes": [{"id": "osc1", "params": {"detune_cents": 16.0, "gain": 0.45, "octave": 0, "pulse_mix": 0.25, "saw_mix": 0.6, "sub_sine": 0.35}, "type": "osc_stack"}, {"id": "ens1", "params": {"chorus_depth_ms": 6.0, "chorus_rate_hz": 0.3, "gain": 0.45, "spread_cents": 24.0, "voices": 4}, "type": "string_ensemble"}, {"id": "air1", "params": {"cutoff_hz": 5500.0, "gain": 0.1}, "type": "noise_air"}, {"id": "lfo1", "params": {"rate_hz": 0.11, "shape": "sine"}, "type": "lfo"}, {"id": "lfo2", "params": {"rate_hz": 0.17, "shape": "tri"}, "type": "lfo"}, {"id": "route1", "inputs": {"lfo": "lfo1"}, "params": {"amount": 0.5, "dst": "cutoff", "src": "lfo1"}, "type": "mod_route"}, {"id": "route2", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.35, "dst": "detune", "src": "lfo2"}, "type": "mod_route"}, {"id": "route3", "inputs": {"lfo": "lfo2"}, "params": {"amount": 0.45, "dst": "pan", "src": "lfo2"}, "type": "mod_route"}, {"id": "filt1", "inputs": {}, "params": {"cutoff_hz": 1400.0, "env_amount": 0.4, "key_track": 0.6, "resonance": 0.55}, "type": "filter_lp"}, {"id": "env1", "params": {"attack_s": 0.6, "decay_s": 1.2, "release_s": 2.2, "sustain": 0.7}, "type": "amp_env"}, {"id": "mix1", "inputs": {"a": "osc1", "b": "ens1", "c": "air1"}, "params": {"gain": 1.0}, "type": "mixer"}, {"id": "ch1", "inputs": {"in": "mix1"}, "params": {"depth_ms": 5.0, "mix": 0.35, "rate": 0.6}, "type": "chorus"}, {"id": "dly1", "inputs": {"in": "ch1"}, "params": {"damp": 0.45, "feedback": 0.4, "mix": 0.25, "time_ms": 450.0}, "type": "delay"}, {"id": "vrb1", "inputs": {"in": "dly1"}, "params": {"damp": 0.55, "mix": 0.35, "size": 0.65}, "type": "reverb"}, {"id": "out", "inputs": {"in": "vrb1"}, "params": {"gain": 0.8, "softclip": true, "width": 1.0}, "type": "output"}], "schema": "padsynth-patch/1.0"}